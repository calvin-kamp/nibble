<mjml>
  <mj-head>
    <mj-title>Passwort zurücksetzen</mj-title>
    <mj-include path="./layouts/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-include path="./layouts/header.mjml" />

    <mj-section>
      <mj-column>
        <mj-text>Hallo,</mj-text>
        <mj-text>über diesen Button kannst du ein neues Passwort setzen.</mj-text>
        <mj-button href="{{ link }}">Neues Passwort setzen</mj-button>
        <mj-text>Der Link ist 1 Stunde gültig. Wenn du das nicht angefordert hast, kannst du diese E-Mail ignorieren.</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./layouts/footer.mjml" />
  </mj-body>
</mjml>
