<mjml lang="de">
  <mj-head>
    <mj-title>Passwort zurücksetzen</mj-title>
    <mj-preview>Passwort zurücksetzen</mj-preview>
    <mj-include path="./layouts/head.mjml" />
  </mj-head>
  <mj-body background-color="#f3f6ec" width="600px">
    <mj-include path="./layouts/header.mjml" />

    <mj-section mj-class="content">
      <mj-column>
        <mj-text mj-class="title">Passwort zurücksetzen</mj-text>
        <mj-text>Hallo,</mj-text>
        <mj-text>über diesen Button kannst du ein neues Passwort setzen.</mj-text>
        <mj-button href="{{ link }}">Neues Passwort setzen</mj-button>
        <mj-text mj-class="muted">Der Link ist 1 Stunde gültig. Wenn du das nicht angefordert hast, kannst du diese E-Mail ignorieren.</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./layouts/footer.mjml" />
  </mj-body>
</mjml>
