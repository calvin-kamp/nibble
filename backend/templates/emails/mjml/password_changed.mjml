<mjml>
  <mj-head>
    <mj-title>Dein Passwort wurde geändert</mj-title>
    <mj-include path="./layouts/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-include path="./layouts/header.mjml" />

    <mj-section>
      <mj-column>
        <mj-text>Hallo,</mj-text>
        <mj-text>das Passwort deines Kontos wurde gerade geändert. Wenn du das nicht warst, setze dein Passwort bitte sofort über „Passwort vergessen“ zurück.</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./layouts/footer.mjml" />
  </mj-body>
</mjml>
