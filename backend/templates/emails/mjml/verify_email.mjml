<mjml lang="de">
  <mj-head>
    <mj-title>Bitte bestätige deine E-Mail-Adresse</mj-title>
    <mj-preview>Bitte bestätige deine E-Mail-Adresse</mj-preview>
    <mj-include path="./layouts/head.mjml" />
  </mj-head>
  <mj-body background-color="#f3f6ec" width="600px">
    <mj-include path="./layouts/header.mjml" />

    <mj-section mj-class="content">
      <mj-column>
        <mj-text mj-class="title">Bitte bestätige deine E-Mail-Adresse</mj-text>
        <mj-text>Hallo,</mj-text>
        <mj-text>bitte bestätige deine E-Mail-Adresse über diesen Button.</mj-text>
        <mj-button href="{{ link }}">E-Mail bestätigen</mj-button>
        <mj-text mj-class="muted">Der Link ist 3 Tage gültig.</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./layouts/footer.mjml" />
  </mj-body>
</mjml>
