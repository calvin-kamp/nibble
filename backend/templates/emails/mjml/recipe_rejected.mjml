<mjml lang="de">
  <mj-head>
    <mj-title>Dein Rezept wurde abgelehnt</mj-title>
    <mj-preview>Dein Rezept wurde abgelehnt</mj-preview>
    <mj-include path="./layouts/head.mjml" />
  </mj-head>
  <mj-body background-color="#f3f6ec" width="600px">
    <mj-include path="./layouts/header.mjml" />

    <mj-section mj-class="content">
      <mj-column>
        <mj-text mj-class="title">Dein Rezept wurde abgelehnt</mj-text>
        <mj-text>Hallo,</mj-text>
        <mj-text>{{ kind }} „{{ name }}“ wurde leider abgelehnt.</mj-text>
        <mj-text>Begründung:<br />{{ reason|linebreaksbr }}</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./layouts/footer.mjml" />
  </mj-body>
</mjml>
